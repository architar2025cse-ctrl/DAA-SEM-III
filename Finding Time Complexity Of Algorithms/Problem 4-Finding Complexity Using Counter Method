count++; // For each successful True evaluation of (j < n)
count++; // For the initial/final False evaluation of the condition (k < n)
for (int k = 1; k < n; k = k * 2) {
count++; // For each successful True evaluation of (k < n)
count++; // 1 step for the execution of the loop body statement (c++)
c++; } } }

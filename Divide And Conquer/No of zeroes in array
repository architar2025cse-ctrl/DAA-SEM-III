#include <stdio.h>
#include <stdlib.h>
// Function to find the index of the first zero using binary search
int findFirstZero(int arr[], int low, int high, int size) {
if (high >= low) {
int mid = low + (high - low) / 2;
// Check if mid is the first zero
if ((mid == 0 || arr[mid - 1] == 1) && arr[mid] == 0) {
return mid;
}
// If the element at mid is 1, search in the right half
else if (arr[mid] == 1) {
return findFirstZero(arr, mid + 1, high, size);
}
// Else search in the left half
else {
return findFirstZero(arr, low, mid - 1, size);
}
}
return -1; // No zero found
}
int main() {
int m;
// Read size of array
if (scanf("%d", &m) != 1 || m <= 0) {
printf("Invalid array size.\n");
return 1;
}
int *arr = (int *)malloc(m * sizeof(int));
if (!arr) {
printf("Memory allocation failed.\n");
return 1;
}
// Read array elements
for (int i = 0; i < m; i++) {
if (scanf("%d", &arr[i]) != 1 || (arr[i] != 0 && arr[i] != 1)) {
printf("Invalid input. Only 0s and 1s allowed.\n");
free(arr);
return 1;
}
}

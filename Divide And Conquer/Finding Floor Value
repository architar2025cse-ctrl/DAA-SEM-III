#include <stdio.h>
#include <stdlib.h>
int majorityElement(int *nums, int n) {
int candidate = 0, count = 0;
for (int i = 0; i < n; i++) {
if (count == 0) {
candidate = nums[i];
count = 1;
} else if (nums[i] == candidate) {
count++;
} else {
count--;
}
}
return candidate;
}
int main() {
int n;
if (scanf("%d", &n) != 1 || n <= 0) {
return 0; // Invalid input, exit silently
}
int *nums = malloc(n * sizeof(int));
if (!nums) return 0; // Memory allocation failed
for (int i = 0; i < n; i++) {
if (scanf("%d", &nums[i]) != 1) {
free(nums);
return 0; // Invalid input}
}
printf("%d\n", majorityElement(nums, n));
free(nums);
return 0;}
